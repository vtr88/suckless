#!/bin/sh

# psuinfo as vezes falha ou retorna vazio por um ciclo.
# Para evitar "n/a" piscando na barra, guardamos o ultimo valor valido.
cache="${XDG_CACHE_HOME:-$HOME/.cache}/slstatus-psu"

out=$(/usr/bin/psuinfo -CgM 2>/dev/null)
if [ -n "$out" ]; then
	printf '%s\n' "$out" > "$cache"
	printf '%s\n' "$out"
elif [ -s "$cache" ]; then
	# Se o comando falhar, mostra o ultimo valor bom.
	cat "$cache"
fi
